<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12+.
   Cleanser's database stores choices keyed by this phone's gallery IDs, which point to
   different (or no) files on another phone, so it is never backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
